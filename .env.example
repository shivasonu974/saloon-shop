# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# ADMIN CREDENTIALS
# ============================================
# Default admin email and password for authentication
ADMIN_EMAIL=sonu@streetsaloon.com
ADMIN_PASSWORD=admin123

# JWT Secret for admin token signing
ADMIN_JWT_SECRET=admin-secret-key

# ============================================
# NOTIFICATION CHANNELS (Optional)
# ============================================

# --- WhatsApp Integration ---
# To enable WhatsApp notifications, configure one of:
# 1. Twilio: https://www.twilio.com/en-us/messaging/whatsapp
# 2. WhatsApp Cloud API: https://developers.facebook.com/docs/whatsapp/cloud-api
#
# Example for Twilio:
# WHATSAPP_API_URL=https://api.twilio.com/2010-04-01/Accounts/{AccountSID}/Messages.json
# WHATSAPP_API_TOKEN=Basic {Auth_Token}

WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ============================================
# NOTIFICATION CHANNELS (Optional)
# ============================================

# --- WhatsApp Integration ---
# To enable WhatsApp notifications, configure one of:
# 1. Twilio: https://www.twilio.com/en-us/messaging/whatsapp
# 2. WhatsApp Cloud API: https://developers.facebook.com/docs/whatsapp/cloud-api
#
# Example for Twilio:
# WHATSAPP_API_URL=https://api.twilio.com/2010-04-01/Accounts/{AccountSID}/Messages.json
# WHATSAPP_API_TOKEN=Basic {Auth_Token}

WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Email Integration ---
# Configure EMAIL_WEBHOOK_URL to send emails via external service
# 1. SendGrid: https://sendgrid.com/
#    EMAIL_WEBHOOK_URL=https://api.sendgrid.com/v3/mail/send
#    EMAIL_WEBHOOK_TOKEN=Bearer {YOUR_SENDGRID_API_KEY}
#
# 2. AWS SES: https://aws.amazon.com/ses/
#    EMAIL_WEBHOOK_URL=https://email.{region}.amazonaws.com/
#    EMAIL_WEBHOOK_TOKEN=Bearer {YOUR_AWS_TOKEN}
#
# 3. Custom Email Service: Any endpoint that accepts POST with booking data
#
# Expected payload format:
# {
#   "bookingId": "SS-ABC123",
#   "toEmail": "customer@example.com",
#   "customerName": "John Doe",
#   "serviceTitle": "Hair Cut",
#   "date": "2024-01-15",
#   "slot": "02:00 PM",
#   "subject": "Booking Confirmed - SS-ABC123",
#   "emailHtml": "<html>...</html>",
#   "message": "Your booking is confirmed"
# }

EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# --- Direct SMTP Configuration (Future Enhancement) ---
# For sending emails directly without external webhook:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@streetsaloon.com

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================
